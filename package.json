    "test": "node --test tests/*.test.ts",
    "typecheck": "node node_modules/typescript/bin/tsc -p tsconfig.json --noEmit",
    "bench": "node bench/run.ts"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "electron": "^38.0.0",
    "typescript": "^5.9.0"
  }
