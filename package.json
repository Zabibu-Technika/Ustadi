{
  "name": "ustadi",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Ustadi — the local-first merchant operating layer. Counter, pocket, ledger.",
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
